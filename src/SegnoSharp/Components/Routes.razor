@using Whitestone.SegnoSharp.Components.Pages
@using Whitestone.SegnoSharp.Shared.Components.Layouts
<Router AppAssembly="@typeof(Bootstrapper).Assembly" NotFoundPage="@typeof(NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                <NotAuthorizedContent />
            </NotAuthorized>
            <Authorizing>
                <h1>Authentication in progress</h1>
                <p>Only visible while authentication is in progress.</p>
            </Authorizing>
        </AuthorizeRouteView>
    </Found>
</Router>